[Unit]
Description=Gunicorn instance to serve CertiSign API Gateway
After=network.target

[Service]
User=ssatl
Group=ssatl
WorkingDirectory=/home/ssatl/Documents/Doc@uthANTIC/backend/fastapi/api_gateway
ExecStart=/home/ssatl/Documents/Doc@uthANTIC/backend/fastapi/.venv/bin/gunicorn main:app --workers 4 --worker-class uvicorn.workers.UvicornWorker --bind 127.0.0.1:8001
Restart=always

[Install]
WantedBy=multi-user.target
