# Configuration du logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)
app = FastAPI(
    title="Service de Signature Numérique",
    description="API pour signer et vérifier la signature numérique de documents PDF et autres fichiers",
    version="2.0.0",
)

# Obtenir le répertoire courant
current_dir = os.getcwd()

# Définir le chemin du répertoire "signed_files" dans le répertoire courant
signed_files_dir = os.path.join(current_dir, "signed_files")

# Créer le répertoire s'il n'existe pas
os.makedirs(signed_files_dir, exist_ok=True)

# Fonction pour nettoyer les fichiers temporaires
def cleanup_temp_files(file_paths):
    """Supprime les fichiers temporaires après un délai"""
    time.sleep(300)  # Attendre 5 minutes
    for file_path in file_paths:
        try:
            if os.path.exists(file_path):
                os.remove(file_path)
                logger.info(f"Fichier temporaire supprimé: {file_path}")
            else:
                logger.debug(f"Fichier temporaire n'existe plus: {file_path}")
        except Exception as e:
            logger.error(f"Erreur lors de la suppression du fichier temporaire {file_path}: {e}")

def add_qr_code_to_pdf(pdf_data: bytes, signature: bytes) -> bytes:
    """
    Ajoute un QR code contenant la signature au PDF en préservant son contenu.
    
    Args:
        pdf_data (bytes): Données du PDF original
        signature (bytes): Signature à encoder dans le QR code
        
    Returns:
        bytes: PDF modifié avec le QR code
    """
    try:
        # Créer le QR code
        qr = qrcode.QRCode(
            version=1,
            error_correction=qrcode.constants.ERROR_CORRECT_H,
            box_size=10,
            border=4,
        )
        # Encoder la signature en base64 pour le QR code
        signature_b64 = base64.b64encode(signature).decode()
        qr.add_data(signature_b64)
        qr.make(fit=True)
        
        # Créer l'image du QR code
        qr_image = qr.make_image(fill_color="black", back_color="white")
        
        # Sauvegarder l'image du QR code dans un fichier temporaire
        temp_dir = tempfile.gettempdir()
        temp_qr_path = os.path.join(temp_dir, f"temp_qr_{uuid.uuid4()}.png")
        qr_image.save(temp_qr_path)
        
        try:
            # Lire le PDF original
            pdf_reader = PdfReader(BytesIO(pdf_data))
            pdf_writer = PdfWriter()
            
            # Créer une page avec le QR code
            qr_canvas = canvas.Canvas(BytesIO(), pagesize=letter)
            qr_size = 1 * inch
            qr_canvas.drawImage(temp_qr_path, 
                              letter[0] - qr_size - 0.5*inch, 
                              0.5*inch, 
                              width=qr_size, 
                              height=qr_size, 
                              preserveAspectRatio=True)
            qr_canvas.save()
            
            # Fusionner le QR code avec chaque page du PDF
            for page in pdf_reader.pages:
                # Créer une nouvelle page avec le contenu original
                new_page = page
                
                # Fusionner le QR code avec la page
                qr_page = PdfReader(BytesIO(qr_canvas.getvalue())).pages[0]
                new_page.merge_page(qr_page)
                
                # Ajouter la page modifiée au writer
                pdf_writer.add_page(new_page)
            
            # Sauvegarder le PDF modifié
            output_buffer = BytesIO()
            pdf_writer.write(output_buffer)
            output_buffer.seek(0)
            
            return output_buffer.getvalue()
            
        finally:
            # Nettoyer le fichier temporaire
            if os.path.exists(temp_qr_path):
                os.remove(temp_qr_path)
        
    except Exception as e:
        logger.error(f"Erreur lors de l'ajout du QR code au PDF: {str(e)}")
        raise

def embed_signature_in_pdf(pdf_data: bytes, signature: bytes) -> bytes:
    """
    Intègre la signature numérique dans les métadonnées du PDF ET ajoute un QR code visible 
    dans le coin inférieur droit du document tout en préservant son contenu.
    
    Args:
        pdf_data (bytes): Données du PDF original
        signature (bytes): Signature à intégrer
        
    Returns:
        bytes: PDF avec la signature intégrée et le QR code
    """
    try:
        # Encoder la signature en base64
        signature_b64 = base64.b64encode(signature).decode()
        
        # Calculer le hash du document original
        original_hash = hashlib.sha256(pdf_data).hexdigest()
        
        # Créer le QR code
        qr = qrcode.QRCode(
            version=1,
            error_correction=qrcode.constants.ERROR_CORRECT_H,
            box_size=10,
            border=4,
        )
        qr.add_data(signature_b64)
        qr.make(fit=True)
        
        # Créer l'image du QR code
        qr_image = qr.make_image(fill_color="black", back_color="white")
        
        # Sauvegarder l'image du QR code dans un fichier temporaire
        temp_dir = tempfile.gettempdir()
        temp_qr_path = os.path.join(temp_dir, f"temp_qr_{uuid.uuid4()}.png")
        qr_image.save(temp_qr_path)
        
        try:
            # Lire le PDF original
            pdf_reader = PdfReader(BytesIO(pdf_data))
            pdf_writer = PdfWriter()
            
            # Créer un buffer pour stocker le PDF du QR code
            qr_buffer = BytesIO()
            
            # Créer une page PDF avec le QR code dans le coin inférieur droit
            qr_canvas = canvas.Canvas(qr_buffer, pagesize=letter)
            qr_size = 1 * inch
            qr_canvas.drawImage(temp_qr_path, 
                              letter[0] - qr_size - 0.5*inch, 
                              0.5*inch, 
                              width=qr_size, 
                              height=qr_size, 
                              preserveAspectRatio=True)
            qr_canvas.save()
            
            # Réinitialiser le buffer pour lecture
            qr_buffer.seek(0)
            
            # Charger le PDF contenant le QR code
            qr_pdf = PdfReader(qr_buffer)
            
            # Fusionner chaque page du PDF original avec le QR code
            for page in pdf_reader.pages:
                # Ajouter la page originale
                page.merge_page(qr_pdf.pages[0])
                pdf_writer.add_page(page)
            
            # Ajouter la signature dans les métadonnées du PDF
            metadata_dict = {
                "/CertiSignSignature": signature_b64,
                "/SignatureDate": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "/SignatureVersion": "2.0",
                "/OriginalDocumentHash": original_hash
            }
            
            # Ajouter les métadonnées au PDF
            pdf_writer.add_metadata(metadata_dict)
            
            # Sauvegarder le PDF modifié
            output_buffer = BytesIO()
            pdf_writer.write(output_buffer)
            output_buffer.seek(0)
            
            return output_buffer.getvalue()
            
        finally:
            # Nettoyer le fichier temporaire
            if os.path.exists(temp_qr_path):
                os.remove(temp_qr_path)
        
    except Exception as e:
        logger.error(f"Erreur lors de l'intégration de la signature dans le PDF: {str(e)}")
        raise

def extract_signature_from_pdf(pdf_data: bytes) -> bytes:
    """
    Extrait la signature du PDF, soit depuis les métadonnées soit depuis le QR code.
    Essaie d'abord les métadonnées, puis le QR code si les métadonnées ne contiennent pas la signature.
    
    Args:
        pdf_data (bytes): Données du PDF signé
        
    Returns:
        bytes: Signature extraite
    """
    # Essayer d'abord d'extraire depuis les métadonnées
    try:
        # Lire le PDF
        pdf_reader = PdfReader(BytesIO(pdf_data))
        
        # Extraire les métadonnées
        metadata = pdf_reader.metadata
        
        if metadata:
            # Récupérer la signature
            signature_b64 = metadata.get("/CertiSignSignature")
            
            if signature_b64:
                # Décoder la signature
                return base64.b64decode(signature_b64)
    
    except Exception as e:
        logger.warning(f"Échec de l'extraction de la signature depuis les métadonnées: {str(e)}")
    
    # Si l'extraction depuis les métadonnées a échoué, essayer le QR code
    try:
        # Convertir le PDF en image pour analyser le QR code
        import tempfile
        import cv2
        import numpy as np
        from pdf2image import convert_from_bytes
        
        # Convertir le PDF en images
        images = convert_from_bytes(pdf_data)
        
        if not images:
            raise ValueError("Impossible de convertir le PDF en image")
        
        # Essayer de trouver un QR code dans chaque page
        for i, page_image in enumerate(images):
            # Convertir en format OpenCV
            opencv_image = cv2.cvtColor(np.array(page_image), cv2.COLOR_RGB2BGR)
            
            # Détecter les QR codes
            qr_detector = cv2.QRCodeDetector()
            retval, decoded_info, points, straight_qrcode = qr_detector.detectAndDecodeMulti(opencv_image)
            
            if retval and decoded_info:
                # Prendre le premier QR code trouvé
                signature_b64 = decoded_info[0]
                
                # Décoder la signature
                return base64.b64decode(signature_b64)
        
        # Si on arrive ici, aucun QR code n'a été trouvé
        raise ValueError("Aucun QR code contenant une signature n'a été trouvé dans le document")
        
    except Exception as e:
        logger.error(f"Échec de l'extraction de la signature depuis le QR code: {str(e)}")
        raise ValueError("Impossible d'extraire la signature du document (ni depuis les métadonnées, ni depuis le QR code)")

def recreate_original_document(pdf_data: bytes) -> bytes:
    """
    Tente de recréer le document original à partir du document signé
    en supprimant le QR code et en gardant le contenu d'origine.
    
    Args:
        pdf_data (bytes): Données du PDF signé
        
    Returns:
        bytes: Données du PDF "nettoyé"
    """
    try:
        # Lire le PDF
        pdf_reader = PdfReader(BytesIO(pdf_data))
        pdf_writer = PdfWriter()
        
        # Copier toutes les pages mais sans le QR code (hypothèse: le QR code est une annotation)
        for page in pdf_reader.pages:
            # Créer une copie de la page
            new_page = PdfReader(BytesIO(pdf_data)).pages[0]
            # Copier seulement le contenu principal (pas les annotations)
            # Note: Cette approche est une simplification, cela pourrait ne pas fonctionner parfaitement
            pdf_writer.add_page(page)
        
        # Supprimer les métadonnées liées à la signature
        metadata = pdf_reader.metadata or {}
        cleaned_metadata = {}
        
        # Copier les métadonnées qui ne sont pas liées à la signature
        for key, value in metadata.items():
            if key not in ["/CertiSignSignature", "/SignatureDate", "/SignatureVersion", "/OriginalDocumentHash"]:
                cleaned_metadata[key] = value
        
        # Écrire le PDF nettoyé
        output = BytesIO()
        pdf_writer.add_metadata(cleaned_metadata)
        pdf_writer.write(output)
        output.seek(0)
        
        return output.getvalue()
    except Exception as e:
        logger.error(f"Erreur lors de la recréation du document original: {str(e)}")
        # En cas d'échec, retourner le document tel quel
        return pdf_data

def verify_signature_with_digest(digest_or_data: bytes, signature: bytes, public_key, is_digest: bool = False):
    """
    Vérifie la signature d'un fichier ou d'un digest avec la clé publique.
    
    Args:
        digest_or_data (bytes): Soit le digest pré-calculé, soit les données du fichier original
        signature (bytes): Signature à vérifier
        public_key: Clé publique utilisée pour la vérification
        is_digest (bool): True si digest_or_data est déjà un digest, False sinon
        
    Returns:
        bool: True si la signature est valide, False sinon
    """
    try:
        # Si digest_or_data est déjà un digest, l'utiliser directement
        # Sinon, calculer le hash SHA-256 du fichier
        if is_digest:
            digest = digest_or_data
        else:
            import hashlib
            digest = hashlib.sha256(digest_or_data).digest()
        
        # Vérification de la signature avec la clé publique
        public_key.verify(
            signature,
            digest,
            asymmetric_padding.PSS(
                mgf=asymmetric_padding.MGF1(hashes.SHA256()),
                salt_length=asymmetric_padding.PSS.MAX_LENGTH
            ),
            hashes.SHA256()
        )
        logger.info("Signature vérifiée et valide")
        return True
    except InvalidSignature:
        # La signature est invalide
        logger.warning("Signature invalide détectée")
        return False
    except Exception as e:
        logger.error(f"Erreur lors de la vérification de la signature: {str(e)}")
        return False

@app.post("/sign", summary="Signer un document")
async def sign_document(
    background_tasks: BackgroundTasks,
    certificate: UploadFile = File(..., description="Certificat PFX (.pfx)"),
    password: str = Form(..., description="Mot de passe du certificat"),
    document: UploadFile = File(..., description="Document à signer (PDF recommandé)"),
    metadata: Optional[str] = Form(None, description="Métadonnées optionnelles pour la signature")
):
    """
    Signe un document PDF avec un certificat PFX, intègre la signature dans les métadonnées 
    et ajoute un QR code visible dans le coin inférieur droit du document.
    """
    start_time = time.time()
    logger.info(f"Nouvelle demande de signature pour le fichier {document.filename}")
    
    # Vérification que le document est un PDF
    if not document.filename.lower().endswith('.pdf'):
        raise HTTPException(status_code=400, detail="Seuls les fichiers PDF sont acceptés")
    
    try:
        # Lire le contenu des fichiers
        pfx_data = await certificate.read()
        document_data = await document.read()
        
        if len(document_data) == 0:
            raise HTTPException(status_code=400, detail="Le document est vide")
        
        # Charger la clé privée
        private_key = load_private_key(pfx_data, password)
        if not private_key:
            raise HTTPException(status_code=400, detail="Impossible de charger la clé privée. Vérifiez le certificat et le mot de passe.")
        
        # Signer le fichier
        signature = sign_file(document_data, private_key)
        
        # Intégrer la signature dans le PDF
        signed_pdf = embed_signature_in_pdf(document_data, signature)
        
        # Générer des noms de fichiers uniques
        original_name = os.path.splitext(document.filename)[0]
        timestamp = datetime.now().strftime("%Y%m%d%H%M%S")
        signed_filename = f"{original_name}_signed_{timestamp}.pdf"
        
        # Chemins complets des fichiers
        signed_path = os.path.join(signed_files_dir, signed_filename)
        
        # Sauvegarder le fichier signé
        with open(signed_path, "wb") as f:
            f.write(signed_pdf)
        
        # Créer un fichier ZIP contenant le fichier signé et le README
        temp_dir = tempfile.gettempdir()
        zip_filename = f"{original_name}_signed_package_{timestamp}.zip"
        zip_path = os.path.join(temp_dir, zip_filename)
        readme_path = os.path.join(temp_dir, "README.txt")
        
        try:
            with zipfile.ZipFile(zip_path, 'w') as zipf:
                zipf.write(signed_path, arcname=signed_filename)
            
            # Ajouter un fichier README.txt avec des instructions
            readme_content = f"""DOCUMENT SIGNÉ NUMÉRIQUEMENT
Date de signature: {datetime.now().strftime("%Y-%m-%d %H:%M:%S")}

Ce package contient:
1. Le document signé: {signed_filename}

La signature numérique est à la fois:
- Intégrée dans les métadonnées du document PDF
- Visible sous forme de QR code dans le coin inférieur droit du document

Pour vérifier la signature, utilisez l'API de vérification.
"""
            with open(readme_path, "w") as f:
                f.write(readme_content)
            zipf.write(readme_path, arcname="README.txt")
        
        # Programmer la suppression des fichiers temporaires
        background_tasks.add_task(cleanup_temp_files, [zip_path, readme_path])
        
        execution_time = time.time() - start_time
        logger.info(f"Signature terminée en {execution_time:.2f} secondes")
        
        return FileResponse(
            zip_path, 
            filename=zip_filename,
            media_type="application/zip"
        )
    except Exception as e:
        # Nettoyer les fichiers en cas d'erreur
        for path in [zip_path, readme_path]:
            if os.path.exists(path):
                try:
                    os.remove(path)
                except:
                    pass
        raise e

@app.post("/verify", summary="Vérifier la signature d'un document")
async def verify_document(
    certificate: UploadFile = File(..., description="Certificat PFX (.pfx)"),
    password: str = Form(..., description="Mot de passe du certificat"),
    document: UploadFile = File(..., description="Document PDF signé à vérifier")
):
    """
    Vérifie la signature d'un document PDF en extrayant la signature depuis les métadonnées
    ou depuis le QR code intégré dans le document.
    """
    start_time = time.time()
    logger.info(f"Nouvelle demande de vérification pour le fichier {document.filename}")
    
    try:
        # Vérification que le document est un PDF
        if not document.filename.lower().endswith('.pdf'):
            raise HTTPException(status_code=400, detail="Seuls les fichiers PDF sont acceptés")
        
        # Lire les fichiers
        pfx_data = await certificate.read()
        document_data = await document.read()
        
        if len(document_data) == 0:
            raise HTTPException(status_code=400, detail="Le document est vide")
        
        # Charger la clé publique
        public_key = load_public_key(pfx_data, password)
        if not public_key:
            raise HTTPException(status_code=400, detail="Impossible de charger la clé publique. Vérifiez le certificat et le mot de passe.")
        
        # Extraire la signature et vérifier si le hash original est disponible
        try:
            pdf_reader = PdfReader(BytesIO(document_data))
            metadata = pdf_reader.metadata or {}
            
            # Extraire la signature
            signature = None
            original_hash = None
            
            # Essayer d'abord d'extraire depuis les métadonnées
            if metadata:
                signature_b64 = metadata.get("/CertiSignSignature")
                if signature_b64:
                    signature = base64.b64decode(signature_b64)
                original_hash = metadata.get("/OriginalDocumentHash")
            
            # Si pas de signature dans les métadonnées, tenter d'extraire du QR code
            if not signature:
                signature = extract_signature_from_pdf(document_data)
            
            # Si nous avons un hash original, l'utiliser pour la vérification
            is_valid = False
            if original_hash:
                logger.info(f"Utilisation du hash original pour la vérification: {original_hash}")
                document_hash = bytes.fromhex(original_hash)
                is_valid = verify_signature_with_digest(document_hash, signature, public_key, is_digest=True)
            else:
                # Sinon, essayer de recréer le document original et vérifier avec lui
                logger.info("Hash original non trouvé, tentative de recréer le document original")
                recreated_document = recreate_original_document(document_data)
                is_valid = verify_signature(recreated_document, signature, public_key)
                
                # Si cela échoue, essayer avec le document original comme solution de secours
                if not is_valid:
                    logger.warning("Échec avec le document recréé, tentative avec le document original")
                    is_valid = verify_signature(document_data, signature, public_key)
            
        except ValueError as e:
            raise HTTPException(status_code=400, detail=str(e))
        except Exception as e:
            logger.error(f"Erreur lors de l'extraction ou de la vérification: {str(e)}")
            raise HTTPException(status_code=400, detail=f"Impossible de vérifier la signature: {str(e)}")
        
        execution_time = time.time() - start_time
        logger.info(f"Vérification terminée en {execution_time:.2f} secondes, résultat: {'valide' if is_valid else 'invalide'}")
        
        if is_valid:
            return JSONResponse({
                "status": "success",
                "message": "La signature est valide. L'intégrité du document est confirmée.",
                "valid": True,
                "verification_time": f"{execution_time:.2f} secondes"
            })
        else:
            return JSONResponse({
                "status": "invalid",
                "message": "La signature est invalide. Le document ou la signature a peut-être été modifié.",
                "valid": False,
                "verification_time": f"{execution_time:.2f} secondes"
            }, status_code=200)

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Erreur lors de la vérification: {str(e)}", exc_info=True)
        raise HTTPException(status_code=500, detail=f"Erreur lors de la vérification: {str(e)}")


@app.get("/health", summary="Vérifier l'état du service")
async def health_check():
    """Vérifie que le service fonctionne correctement"""
    return {"status": "online", "service": "signature", "timestamp": datetime.now().isoformat()}
